# Sunucu tarafında (Route Handler'lar) kullanılır, tarayıcıya asla gönderilmez.
LARAVEL_API_URL=http://127.0.0.1:8123/api
LARAVEL_BASE_URL=http://127.0.0.1:8123

# Tarayıcıda Laravel Echo/Reverb bağlantısı için — bunlar public bilgilerdir
# (Reverb app key'i zaten WebSocket handshake'inde açık şekilde kullanılır).
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=127.0.0.1
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
